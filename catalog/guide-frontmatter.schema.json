{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Web of Flaws guide frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "kind",
    "default_severity",
    "exploitability",
    "standards",
    "platforms",
    "languages",
    "detection",
    "tags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^WOF-[A-Z0-9]+-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "pattern": "\\S"
    },
    "kind": {
      "enum": ["vulnerability", "weakness", "hardening-gap"]
    },
    "default_severity": {
      "enum": ["low", "medium", "high", "critical"]
    },
    "exploitability": {
      "enum": ["low", "medium", "high"]
    },
    "standards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cwe", "owasp_top_10"],
      "properties": {
        "cwe": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^CWE-[0-9]+$"
          }
        },
        "owasp_top_10": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^A[0-9]{2}:[0-9]{4} .+$"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "relationship"],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^A[0-9]{2}:[0-9]{4} .+$"
                  },
                  "relationship": {
                    "enum": ["direct", "related"]
                  }
                }
              }
            ]
          }
        },
        "mappings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cwe", "owasp_top_10", "relationship"],
            "properties": {
              "cwe": {
                "type": "string",
                "pattern": "^CWE-[0-9]+$"
              },
              "owasp_top_10": {
                "type": "string",
                "pattern": "^A[0-9]{2}:[0-9]{4} .+$"
              },
              "relationship": {
                "enum": ["direct", "related"]
              }
            }
          }
        }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["browser", "server", "mobile", "desktop", "ci-cd", "infrastructure", "cloud", "container"]
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["html", "javascript", "typescript", "yaml", "dotenv", "json", "css", "python", "shell", "bash", "sql", "terraform"]
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "methods"],
      "properties": {
        "type": {
          "enum": ["dataflow", "semantic-pattern"]
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["grep", "ast", "taint-analysis", "semantic-review", "entropy-analysis"]
          }
        },
        "candidate_tokens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "sources": {
      "$ref": "#/$defs/non_empty_string_list"
    },
    "sinks": {
      "$ref": "#/$defs/non_empty_string_list"
    },
    "indicators": {
      "$ref": "#/$defs/non_empty_string_list"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "detection": {
            "properties": {
              "type": {
                "const": "dataflow"
              }
            },
            "required": ["type"]
          }
        }
      },
      "then": {
        "required": ["sources", "sinks"],
        "properties": {
          "indicators": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "detection": {
            "properties": {
              "type": {
                "const": "semantic-pattern"
              }
            },
            "required": ["type"]
          }
        }
      },
      "then": {
        "required": ["indicators"],
        "properties": {
          "sources": false,
          "sinks": false
        }
      }
    }
  ],
  "$defs": {
    "non_empty_string_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    }
  }
}
