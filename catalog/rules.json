      "id": "WOF-XSS-001",
      "path": "guides/injection/xss/url-derived-input-to-html-sink-innerhtml.md",
      "title": "URL-derived Input to HTML Sink (innerHTML)",
      "kind": "vulnerability",
      "severity": "high",
      "exploitability": "high",
      "standards": {
